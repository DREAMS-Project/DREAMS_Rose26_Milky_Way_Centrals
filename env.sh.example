# Copy to env.sh, edit, and `source env.sh` before running the pipeline.

# Root of the DREAMS data (must contain Sims/, FOF_Subfind/, Parameters/)
export DREAMS_DATA=/path/to/DREAMS

# This repository (used by GSEprob.ipynb)
export MWOBS_ROOT=$(pwd)

# NeHOD (https://github.com/trivnguyen/nehod_torch @ a2fb2d5, with the two fixes in README.md);
# its repository root must be importable (`from nehod import ...`, `import datasets`)
export NEHOD_TORCH=/path/to/nehod_torch
export PYTHONPATH=$NEHOD_TORCH:$PYTHONPATH

# App. D only: RoseArepo (readData.DataLoader)
# export PYTHONPATH=/path/to/RoseArepo:$PYTHONPATH

# Calc_Master.ipynb visualisation cells only
# export TORREYLABTOOLS=/path/to/torreylabtools
